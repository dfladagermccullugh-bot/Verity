# Settings for the Verity Voice server. Copy to .env for local use; .env is never committed.
# With nothing set, the server runs the browser demo and reads answers by rule only.

PORT=3000

# Read natural replies with Claude (demo and calls). Optional.
ANTHROPIC_API_KEY=
# VERITY_CLASSIFIER_MODEL=claude-haiku-5-5

# Real phone calls: ALL of these are needed, or no call is placed.
DATABASE_URL=
DIAL_CAMPAIGN_ID=
# Your own number while testing. The word "campaign" allows everyone in the campaign with
# consent on file: only after legal review of the consent wording.
DIAL_ALLOWLIST=
PUBLIC_BASE_URL=
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=
TELNYX_PUBLIC_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# TTS_VENDOR=deepgram
# SPEECH_CACHE_DIR=/data/speech
